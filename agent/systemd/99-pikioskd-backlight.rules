# Let the kiosk user set panel brightness without root.
#
# WITHOUT THIS THE BRIGHTNESS CONTROL FAILS CLOSED, WHICH IS THE CORRECT
# FAILURE and is why the agent raises rather than silently succeeding: a
# slider that moves and changes nothing teaches an operator that the control
# works. On a wall driving an HDMI monitor there is no backlight device at all
# and this rule matches nothing — that is expected, not a broken install.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
