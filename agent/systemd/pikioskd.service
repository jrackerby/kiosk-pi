[Unit]
Description=Raspberry Pi kiosk agent (pikioskd)
Documentation=https://github.com/jrackerby/kiosk-pi
# The agent OWNS the browser, so it must not race the retired kiosk.service for
# the DRM device. Conflicts= stops both being active at once even if somebody
# re-enables the old unit by hand during a recovery.
Conflicts=kiosk.service
# systemd only accepts this in [Unit]; in [Service] it is parsed as an unknown
# key and IGNORED, which reads in the journal as a one-line warning nobody
# chases and leaves the default start limit in force.
StartLimitIntervalSec=0
After=network-online.target systemd-user-sessions.service
Wants=network-online.target

[Service]
# NOTIFY, NOT SIMPLE. Under Type=simple systemd knows one thing about this
# process: whether it exited. A supervision loop deadlocked, an HTTP thread
# wedged, a tick hung in a subprocess — each reads `active (running)` for
# ever, which is the exact failure this agent accuses a bare Restart=always
# of hiding about the browser. The agent sends READY=1 once the API is bound
# (so `systemctl start`, and install.sh behind it, return to a serving agent)
# and WATCHDOG=1 once a second while BOTH its threads are provably alive;
# silence for WatchdogSec gets it killed and restarted. The agent's own
# stale threshold is six ticks (30s), so 90s is three misses, never one.
Type=notify
NotifyAccess=main
WatchdogSec=90
User=kiosk
Group=kiosk
# The compositor needs a seat and the DRM/input devices. These are the groups a
# Raspberry Pi OS image puts them in; the installer verifies membership rather
# than assuming it.
SupplementaryGroups=video render input tty

Environment=PYTHONUNBUFFERED=1
# `python3 -m` already prepends the working directory, but stating the
# path means a unit edited to run from elsewhere still finds the package
# instead of failing with an import error that reads like a bad install.
Environment=PYTHONPATH=/opt/pikioskd
# One value, fleet-wide. A per-host variant here is a defect, not hardware:
# display.py and browser.py both DEFER to an XDG_RUNTIME_DIR already in the
# environment, so this is the single place it is decided for a systemd start.
Environment=XDG_RUNTIME_DIR=/run/kiosk-wayland
# MESA'S SHADER CACHE LIVES HERE, NOT UNDER /home. Mesa writes it to
# $XDG_CACHE_HOME, falling back to ~/.cache, which ProtectHome=read-only makes
# unwritable — and the GPU process then SEGFAULTS at start instead of running
# uncached. Chromium retries, gives up, relaunches it with --use-gl=disabled
# and renders every frame on the CPU; the wall still draws, so nothing reads
# as broken. Measured on a Pi 4 at 2560x1440: GPU process at 99% CPU, ~2 fps.
# Inside StateDirectory, so it is writable by construction; Mesa creates the
# last path component itself. test_unit_sandbox.py asserts it stays writable.
Environment=XDG_CACHE_HOME=/var/lib/pikioskd/cache
RuntimeDirectory=kiosk-wayland
RuntimeDirectoryMode=0700

ExecStart=/usr/bin/python3 -m pikioskd --settings /etc/pikioskd/settings.json
WorkingDirectory=/opt/pikioskd

# Restart=always, backed off, never given up on. The BROWSER's restarts are
# the agent's to back off and count; these directives govern the AGENT, and
# an agent that cannot start (a bad upgrade, an import error) under a flat
# RestartSec=5 relaunches 17,000 times a day into the journal of an SD card.
# RestartSteps/RestartMaxDelaySec (systemd >= 254) grow the delay from 5s to
# 300s over six failures and reset it once a start holds. StartLimitIntervalSec=0
# above keeps systemd from giving up permanently on a panel that had a bad
# week, which would leave the wall dark until somebody noticed.
Restart=always
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=300
# A stop is ordered: SIGTERM to the agent alone, which tears the browser's
# process group down itself (browser._terminate) before exiting; anything
# still standing after TimeoutStopSec is killed. Under the default
# KillMode=control-group the agent, cage and Chromium all get SIGTERM at once
# and the agent finds a browser already dying under it.
KillMode=mixed
TimeoutStopSec=30

# OOM. The default OOMPolicy=stop means a kernel OOM-kill of ANY process in
# this cgroup — a Chromium renderer on a 1GB Pi 3B — stops the whole service,
# agent included, and the API vanishes mid-poll. `continue` leaves the agent
# standing to relaunch the browser, which is the design. OOMScoreAdjust puts
# the agent behind the browser in the kernel's ordering; the agent raises the
# browser's own score back to 0 at launch (browser._prefer_browser_for_oom),
# since a child inherits the parent's and an unprivileged process may only
# raise it.
OOMPolicy=continue
OOMScoreAdjust=-500

# The agent reboots the host and writes /etc/pikioskd, so it is not sandboxed
# to nothing — but it has no business writing anywhere else.
#
# NoNewPrivileges IS DELIBERATELY OFF, AND IT CANNOT BE ON. It sets
# PR_SET_NO_NEW_PRIVS, which stops a setuid binary from elevating at all —
# sudo detects it and refuses outright: "The \"no new privileges\" flag is set,
# which prevents sudo from running as root." `rebootDevice` is the agent's one
# privileged verb and it goes through sudo, so switching this on forbids the
# exact operation the sudoers drop-in exists to allow, and does it silently:
# the reboot is scheduled in a detached shell whose failure nobody reads.
# The real boundary is /etc/sudoers.d/pikioskd, which grants ONE command.
# Measured with prctl(PR_SET_NO_NEW_PRIVS) against a real setuid sudo,
# 2026-09-10; test_unit_sandbox.py asserts the pairing cannot come back.
NoNewPrivileges=no
ProtectSystem=full
ReadWritePaths=/etc/pikioskd /tmp
# CHROMIUM'S PROFILE LIVES HERE, NOT UNDER /home. ProtectHome=read-only makes
# every path under /home unwritable, and Chromium exits 21 within a second
# when it cannot write --user-data-dir. The unit still reads `active` because
# Restart=always applies to the AGENT, which is fine — so the wall goes black
# while systemd reports success. Keep this directory and the settings default
# in agent/pikioskd/settings.py in step; test_unit_sandbox.py asserts they are.
StateDirectory=pikioskd
ProtectHome=read-only
PrivateTmp=no

[Install]
WantedBy=multi-user.target
